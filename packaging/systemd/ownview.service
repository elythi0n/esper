# A user service, not a system one.
#
# OwnView runs as the user whose screen and shell it exposes. It needs no
# privilege to do that, and running it as root would mean a compromise of the
# engine is a compromise of the machine rather than of one account.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp ownview.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ownview
#
# On a server you will also want the session to survive logout:
#   sudo loginctl enable-linger $USER
#
# Without that, systemd stops user services when the last session ends — which
# on a headless box means OwnView stops the moment you disconnect, and you
# cannot reconnect to start it again.

[Unit]
Description=OwnView — secure remote desktop and terminal
Documentation=https://github.com/elythi0n/ownview
# Wait for the network so the first bind does not fail on a slow boot. This is
# "online" rather than "up" because binding needs an address, not just a link.
After=network-online.target
Wants=network-online.target

# Rate-limit restarts. These belong in [Unit], not [Service] — systemd ignores
# them silently in the wrong section, which `systemd-analyze verify` caught and
# a reading of the file would not have.
#
# A binary that cannot start — a missing engine, a bad config — would otherwise
# spin forever, and the journal would be the same line ten thousand times
# rather than the error.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/ownview host

# Restart on failure, not on clean exit. `ownview host --once` and a deliberate
# shutdown should stay shut down; a crash should come back.
Restart=on-failure
RestartSec=5s

# ── Hardening ───────────────────────────────────────────────────────────────
#
# The engine needs a display, an input device and a network socket. It does not
# need to write outside its own state directory, gain privileges, or see other
# users' processes. Each line below removes something it never uses, so a
# compromise has less to work with.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ...except its own state, which holds the identity key and device store.
ReadWritePaths=%h/.ownview
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# IPv4, IPv6 and Unix. QUIC is UDP; the Unix socket is the seam to the engine.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Not `ProtectProc=invisible`: the engine reports its own state and, on Linux,
# reads /proc to check whether a shell it started is still alive.
ProtectProc=default

[Install]
WantedBy=default.target
