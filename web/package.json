{
  "name": "esper-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-motion.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "gen:motion": "node scripts/gen-motion.mjs",
    "check:motion": "node scripts/gen-motion.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:discipline": "node scripts/check-discipline.mjs",
    "check:presence": "node scripts/check-presence.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "check": "node scripts/gen-motion.mjs --check && node scripts/check-contrast.mjs && node scripts/check-discipline.mjs && node scripts/check-presence.mjs && node scripts/check-inventory.mjs && node --experimental-strip-types scripts/check-identicon.mjs && tsc -b --noEmit",
    "verify": "pnpm check && pnpm build && node scripts/check-frames.mjs && node scripts/check-a11y.mjs --url http://127.0.0.1:5178/ && node scripts/check-keyboard.mjs --url http://127.0.0.1:5178/ && node scripts/check-words.mjs --url http://127.0.0.1:5178/ && node scripts/check-live.mjs --url http://127.0.0.1:5178/ && node scripts/check-overflow.mjs --url http://127.0.0.1:5178/ && node scripts/check-ink.mjs --url http://127.0.0.1:5178/ && node scripts/check-viewer.mjs --url http://127.0.0.1:5178",
    "check:identicon": "node --experimental-strip-types scripts/check-identicon.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "check:words": "node scripts/check-words.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:ink": "node scripts/check-ink.mjs",
    "check:viewer": "node scripts/check-viewer.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "dockview-react": "^8.3.0",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
